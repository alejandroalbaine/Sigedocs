# Plantilla pública. Copie este archivo a .env y ajuste los valores.
# Todo lo que empieza con VITE_ llega al navegador: nunca ponga secretos aquí.

# Origen del backend (SIGESDOC_BACKEND), sin /api/v1, rutas ni credenciales.
# Vacío = mismo origen que la interfaz (por ejemplo, detrás de un proxy inverso).
# El backend debe incluir el origen de esta interfaz en ALLOWED_ORIGINS (ADR-007).
VITE_API_BASE_URL=http://localhost:3000

# Interruptor de la fuente de datos de Observaciones (B6) y Auditoría (B7).
# true  = datos simulados, la interfaz funciona sin backend (Fase 1).
# false = endpoints reales; exige que el backend ya publique B6 y B7 (Fase 2).
VITE_USE_MOCK_DATA=true

# Latencia artificial del servicio simulado, en milisegundos.
VITE_MOCK_LATENCY_MS=350

# Expediente consultado por Observaciones y Trazabilidad (rutas /dossiers/{dossierId}/...).
VITE_DOSSIER_ID=dossier-demo
