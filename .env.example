# Plantilla pública. Copie este archivo a .env y ajuste los valores.
# Todo lo que empieza con VITE_ llega al navegador: nunca ponga secretos aquí.

# Origen del backend (SIGESDOC_BACKEND), sin /api/v1, rutas ni credenciales.
# Vacío = mismo origen que la interfaz (por ejemplo, detrás de un proxy inverso).
# El backend debe incluir el origen de esta interfaz en ALLOWED_ORIGINS (ADR-007).
VITE_API_BASE_URL=http://localhost:3000
