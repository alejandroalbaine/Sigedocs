# Plantilla pública. No escriba contraseñas reales en este archivo.
# Ejecute `npm run env:setup` para generar un .env privado automáticamente.
PORT=3000
NODE_ENV=development

# Origen público de la API, sin /api ni rutas. Vacío usa el mismo origen.
# Para separar localmente ambos proyectos, confirme primero el puerto de backend.
API_BASE_URL=

# Use strict/lax si comparten sitio; none exige HTTPS en producción.
COOKIE_SAME_SITE=strict

# Sesiones de la aplicación. Debe tener al menos 32 caracteres.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-64-caracteres

# Conexión suministrada por backend o por una instalación normal de PostgreSQL.
# Ejemplo: postgresql://usuario:clave@localhost:5432/sigesdoc
DATABASE_URL=
DB_SSL=false

# Contraseña inicial de las cuentas sembradas. Solo para desarrollo local.
SEED_USER_PASSWORD=reemplazar-por-una-clave-inicial-segura

# Permite probar el login mientras DATABASE_URL está vacía.
ALLOW_DEMO_MODE=true
